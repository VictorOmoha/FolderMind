# ── AI access (hybrid model) ────────────────────────────────────────────────
# BYO mode: a personal OpenAI key used ONLY by the Electron main process. Free and
# unlimited. Do NOT use the VITE_ prefix — Vite inlines VITE_ vars into the shipped
# renderer bundle, which would leak the key. The main process reads OPENAI_API_KEY.
OPENAI_API_KEY=sk-...

# Hosted mode: when no personal key is set and the user is signed in, inference is
# routed through the deployed gateway Cloud Function (metered + plan-gated). Set this
# to the deployed function URL, e.g.
#   https://us-central1-<your-project>.cloudfunctions.net/chatGateway
# Leave empty to disable hosted mode (BYO-only).
FOLDERMIND_GATEWAY_URL=

# Firebase — create a project at https://console.firebase.google.com
# Project Settings > Your apps > Web app > Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
