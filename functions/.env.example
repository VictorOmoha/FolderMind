# Cloud Functions server-side secrets. Copy to functions/.env and fill in.
# These are used by the deployed functions only — never bundled into the desktop app.

# Server OpenAI key used by the hosted AI gateway (chatGateway). This is the key you
# pay for; it powers Pro/Business users who don't bring their own.
OPENAI_API_KEY=sk-...

# Stripe (billing). Test keys are fine for the 5-user pilot.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
