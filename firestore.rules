rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own data
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Usage metadata: additional field-level validation to prevent
    // users from self-assigning elevated plan tiers
    match /users/{uid}/meta/usage {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        // planTier can only be 'free' when written by the client;
        // paid tiers must be set server-side via Cloud Functions
        && (!request.resource.data.keys().hasAny(['planTier'])
            || request.resource.data.planTier == 'free');
    }

    // Folder sync data: only allow known fields
    match /users/{uid}/folders/{folderId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'localPath', 'name', 'memory', 'updatedAt',
          'tasks', 'messages', 'archetype', 'tone'
        ]);
    }
  }
}
