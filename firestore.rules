rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: no recursive `users/{uid}/{document=**}` catch-all here. In Firestore,
    // overlapping match blocks are OR'd, so a catch-all write rule would shadow the
    // field-level restrictions below and let clients self-assign paid plan tiers.
    // Every user-owned path is enumerated explicitly and defaults to deny.

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Usage/plan metadata. Clients may read their own and update counters, but may
    // NOT grant themselves a paid tier — planTier must be absent or 'free' on client
    // writes. Paid tiers are set server-side by the Stripe webhook (Admin SDK, which
    // bypasses these rules).
    match /users/{uid}/meta/usage {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && (!request.resource.data.keys().hasAny(['planTier'])
            || request.resource.data.planTier == 'free');
    }

    // Folder metadata + memory snapshot. Whitelisted fields only.
    match /users/{uid}/folders/{folderId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'localPath', 'name', 'memory', 'updatedAt',
          'tasks', 'messages', 'archetype', 'tone'
        ]);
    }

    // Per-folder sync payloads (tasks / chat snapshots).
    match /users/{uid}/folders/{folderId}/sync/{doc} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // Pilot feedback: signed-in users may submit (create) their own entries only.
    // Reading/editing is done server-side (Admin SDK / console), never from the client.
    match /feedback/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Paid-plan waitlist: one doc per user (keyed by uid) so repeat clicks upsert
    // rather than duplicate. Same write-only posture as feedback.
    match /waitlist/{uid} {
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      allow read, delete: if false;
    }
  }
}
